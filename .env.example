# ================================
# 商城应用环境配置
# ================================

# 应用
APP_NAME=Mall
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_mall
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100

# 日志
LOG_PATH=storage/logs/
LOG_LEVEL=debug
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE=30

# 分页
PAGE_DEFAULT_SIZE=15
PAGE_MAX_SIZE=100
